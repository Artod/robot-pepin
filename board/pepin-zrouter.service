[Unit]
Description=Pepin zenoh router: the board's half of the rmw_zenoh transport
# Deliberately NOT PartOf/BindsTo pepin-ros.service. Every node of the stack is a zenoh PEER
# that keeps an infinite connect retry to this router, and the router is what carries the link
# to the laptop; a router that went down and up with every stack restart would take the laptop's
# half with it each time, which is the failure the zenoh-bridge sidecar used to have. It starts
# before the stack at boot and then stays up on its own.
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
Before=pepin-ros.service
StartLimitIntervalSec=0

[Service]
EnvironmentFile=-/etc/default/pepin-ros
Environment=PEPIN_ZIMAGE=pepin-ros:zenoh
# The router's RUST_LOG: the transport lifecycle and the connector at debug, the rest at info —
# the 2026-09-23 wake left the link dead for 28 minutes with not one line from either router,
# because zenoh says "handshake refused", "transport opened/closed" and "link expired" only at
# debug. The same string as ros/lib.sh's PEPIN_ZROUTER_LOG (a test holds them equal); no
# per-message module is in it. PEPIN_ZROUTER_LOG=info in /etc/default/pepin-ros is the old level.
# Cost on the board: a few log lines per session event, no CPU to speak of (rule 20).
# ZENOH_RUNTIME's RX workers (zenoh's default 2; PEPIN_ZROUTER_RX_WORKERS=2 is the old behaviour):
# while the laptop was asleep this router's two RX threads sat in 20-s pushes to it, the
# "Closing transport!" they scheduled ran on the same two threads and never started, and the
# stack's own sessions timed out on the router — 2026-09-23, reproduced in statics with the
# default and gone with 8 workers (ros/lib.sh's PEPIN_ZROUTER_RX_WORKERS has the numbers). A
# router needs more workers than the sessions that push to the frozen peer (4 publishers wedged 4
# workers, not 5); this one serves 11 (census 2026-09-24: 10 nodes on the loopback and the
# laptop's router), so 16 — the laptop's router, with more sessions, runs 32. Cost: idle threads
# park, one stack each; the census after the deploy is the measurement (rule 20).
Environment=PEPIN_ZROUTER_RX_WORKERS=16
Environment=PEPIN_ZROUTER_LOG=info,zenoh::net::runtime::orchestrator=debug,zenoh_transport::unicast::manager=debug,zenoh_transport::unicast::establishment=debug,zenoh_transport::unicast::universal::link=debug,zenoh_transport::unicast::universal::transport=debug
# The previous router's log first, the way pepin-ros.service keeps Nav2's: the container is not
# auto-removed (no --rm below), so its log outlives a stop, a crash or a reboot until this line
# copies it, with docker's receive stamps, to /root/pepin-ros/logs/zrouter_<local time>.log
# (ros/sync.sh never deletes logs/). Under --rm the log of 2026-09-23's 20-s closures to the
# sleeping laptop was gone with the first restart, and the router's output does not reach the
# journal either. PEPIN_LOG_ARCHIVE=off in /etc/default/pepin-ros keeps nothing, as before.
ExecStartPre=-/bin/sh -c '[ "$${PEPIN_LOG_ARCHIVE:-on}" = off ] || ! /usr/bin/docker container inspect pepin-zrouter >/dev/null 2>&1 || { mkdir -p /root/pepin-ros/logs && /usr/bin/docker logs -t pepin-zrouter > /root/pepin-ros/logs/zrouter_$$(date +%%Y%%m%%d_%%H%%M%%S).log 2>&1; }'
ExecStartPre=-/usr/bin/docker rm -f pepin-zrouter
# No ZENOH_CONFIG_OVERRIDE: the shipped router default already listens on tcp/[::]:7447, which is
# every interface — the board's nodes reach it over the loopback and the laptop's router dials it
# over the WiFi — and this router dials nobody. --network host so the loopback it listens on is
# the same loopback the stack's container lives in.
#   The CONFIG FILE is ros/zenoh/router.json5, one file for both routers, which ros/sync.sh puts
# at /root/pepin-ros/zenoh/router.json5 (it rsyncs the whole of ros/ to /root/pepin-ros/). It
# raises the patience of the reliable tx queue so that a 1-2 s WiFi stall no longer ends the
# session — "Unable to push non droppable network message to <zid>. Closing transport!", 8-12
# times a minute on 2026-09-22, each one costing both machines a re-discovery. The file's own
# header says which key does what.
#   Two ExecStart bodies rather than one, and the difference is only whether the file is there:
# the mount is added ONLY if the path is a file, because docker would otherwise create an empty
# DIRECTORY at it and the router would refuse to start on a board that has not been synced yet.
# Delete the mount, or the file, and rmw_zenohd reads its shipped default again — that is the way
# back (CLAUDE.md rule 19), and it needs no rebuild.
ExecStart=/bin/sh -c 'if [ -f /root/pepin-ros/zenoh/router.json5 ]; then exec /usr/bin/docker run --name pepin-zrouter --network host -e RUST_LOG=$PEPIN_ZROUTER_LOG -e "ZENOH_RUNTIME=(rx: (worker_threads: $PEPIN_ZROUTER_RX_WORKERS))" -v /root/pepin-ros/zenoh/router.json5:/zenoh/router.json5:ro -e ZENOH_ROUTER_CONFIG_URI=/zenoh/router.json5 $PEPIN_ZIMAGE /opt/ros/jazzy/lib/rmw_zenoh_cpp/rmw_zenohd; fi; echo "pepin-zrouter: no /root/pepin-ros/zenoh/router.json5 (ros/sync.sh), starting on the shipped rmw_zenoh default" >&2; exec /usr/bin/docker run --name pepin-zrouter --network host -e RUST_LOG=$PEPIN_ZROUTER_LOG -e "ZENOH_RUNTIME=(rx: (worker_threads: $PEPIN_ZROUTER_RX_WORKERS))" $PEPIN_ZIMAGE /opt/ros/jazzy/lib/rmw_zenoh_cpp/rmw_zenohd'
# `docker run` returns as soon as the container exists, not when rmw_zenohd is ACCEPTING on
# 7447 — so Before=pepin-ros.service orders the two starts and nothing more, and the stack's
# nodes come up against a router that is still binding. Zenoh sessions then form raggedly, and
# a transient-local publication made in that window is never re-queried: on 2026-09-21 that
# delayed /tf_static to Nav2's container by 24 s (the lidar's frame) to 157 s (the ToF mounts),
# which is exactly the window that wedges Nav2's RangeSensorLayer for good
# (scratch/nav2_hang/, and the tof_bridge module docstring). So the unit is not "started" until
# the port answers: 30 s in 0.5 s steps, and a router that never listens fails the unit loudly
# instead of letting the whole stack start behind it. bash for /dev/tcp — nothing else here
# opens a socket, and the board already runs bash units (ros/reap_ros2_cli.sh).
ExecStartPost=/bin/bash -c 'timeout 30 bash -c "until (exec 3<>/dev/tcp/127.0.0.1/7447) 2>/dev/null; do sleep 0.5; done" || { echo "pepin-zrouter: nothing is accepting on tcp/127.0.0.1:7447 after 30 s; the stack must not start behind a router that is not listening" >&2; exit 1; }'
ExecStop=-/usr/bin/docker stop -t 5 pepin-zrouter
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
