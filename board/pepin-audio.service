[Unit]
Description=Pepin audio server: the XVF3800 array's voice, direction and speaker (TCP 3338)
After=sound.target network.target
# Never give up restarting; the server itself waits for the array, which may be plugged in late.
StartLimitIntervalSec=0

[Service]
WorkingDirectory=/opt/pepin
Environment=PYTHONPATH=/opt/pepin
ExecStart=/opt/pepin/bin/python -m pepin.audio_server --port 3338
Restart=on-failure
RestartSec=2
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
