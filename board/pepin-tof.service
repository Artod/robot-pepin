[Unit]
Description=Pepin ToF range streamer (VL53L1X x3 over TCP 3335)
After=tof-init.service network.target
Requires=tof-init.service

[Service]
WorkingDirectory=/opt/pepin
Environment=PYTHONPATH=/opt/pepin
ExecStart=/opt/pepin/bin/python -m pepin.tof_server --port 3335
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
