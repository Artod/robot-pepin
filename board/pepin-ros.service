[Unit]
Description=Pepin ROS 2 sensor stack (lidar, base bridge, ToF, neck, EKF) in Docker
After=docker.service pepin-base.service pepin-tof.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
Requires=docker.service
Wants=pepin-base.service pepin-tof.service

[Service]
# The switches below are ros/feature.sh's, kept in /etc/default/pepin-ros. Navigation runs on the
# laptop; the board runs sensors only.
EnvironmentFile=-/etc/default/pepin-ros
Environment=PEPIN_IMU=true
# The EKF (ros/params/ekf.yaml) fuses whatever odometry sources are alive and owns
# odom -> base_link; it does NOT need the IMU. Off, the bridge publishes that transform from the
# wheels alone and there is no /odometry/filtered.
Environment=PEPIN_EKF=true
# The lidar's own scan-to-scan odometry (rf2o) as a twist for that filter, odom3 in the same file
# (ros/feature.sh laser_odom on|off). A source, not a precondition: off, the filter runs on the
# wheels, the gyro and the camera exactly as before. It publishes no transform.
Environment=PEPIN_LASER_ODOM=true
Environment=PEPIN_TOF=true
# The neck's encoders and the live camera transform (ros/feature.sh neck on|off); with it off the
# laptop's SLAM must start with ros/laptop.sh vslam --fixed-head, or nothing publishes
# base_link -> camera_link.
Environment=PEPIN_NECK=true
# The board's own recording of its raw sensors (pepin.board_bag, ros/feature.sh board_bag on|off):
# minute MCAP files in /root/pepin-ros/maps/board_rec, capped at 20 GB, 10 GB of the card kept free.
Environment=PEPIN_BOARD_BAG=false
# The middleware is rmw_zenoh_cpp against pepin-zrouter.service (ros/run.sh sets it).
# One container per boot; --rm so a stale one never blocks the name. The image is built on the
# laptop and loaded here by ros/build-image.sh --ship.
# No RTC on this board: it boots with yesterday's clock and NTP jumps it hours forward a minute
# later; every stamp taken before the jump is hours stale to the laptop's consumers (the first goal
# died of it, 2026-09-07 11:45). Wait for the sync, but never forever: an offline robot still starts.
# The wait asks the KERNEL, not a daemon, so it holds for systemd-timesyncd and for chrony alike
# (board/chrony.sh): timedated's NTPSynchronized is `adjtimex().maxerror < 16 s` (systemd 257,
# timedated.c ntp_synced, which ignores STA_UNSYNC on purpose), and chronyd writes its real
# error bound there at every clock update and 16 s while it is unsynchronised
# (sys_timex.c set_sync_status). Under chrony's `makestep 1 3` the step can come only in the
# first three updates after chronyd starts, so a stack that waited for the first one starts after
# the jump; one that gave up waiting (no network within 90 s) still takes it later, under it.
ExecStartPre=-/bin/sh -c 'for i in $$(seq 1 90); do [ "$$(timedatectl show -p NTPSynchronized --value)" = yes ] && exit 0; sleep 1; done; echo "clock not synced after 90 s, starting anyway"'
# The previous container's log is the only record of what the sensors did; keep it before the rm.
ExecStartPre=-/bin/sh -c 'mkdir -p /root/pepin-ros/logs && /usr/bin/docker logs pepin-ros > /root/pepin-ros/logs/$$(date +%%Y%%m%%d_%%H%%M%%S).log 2>&1'
ExecStartPre=-/usr/bin/docker rm -f pepin-ros
# run.sh mounts the code from /root/pepin-ros (see it): edits reach the robot via ros/sync.sh, no rebuild.
ExecStart=/root/pepin-ros/run.sh ros2 launch pepin_bringup bringup.launch.py imu:=${PEPIN_IMU} ekf:=${PEPIN_EKF} laser_odom:=${PEPIN_LASER_ODOM} tof:=${PEPIN_TOF} neck:=${PEPIN_NECK} board_bag:=${PEPIN_BOARD_BAG}
# ros2 launch needs more than 5 s to bring a dozen nodes down on this board; a SIGKILL (137)
# after the grace period is still a normal stop, not a failure.
# The container's stop signal is SIGINT (ros/run.sh, ros/Dockerfile), which the launch answers by
# shutting its nodes down — the 30 s here is the launch's own sigterm_timeout, so on a
# `systemctl restart pepin-ros` every node gets the whole window to leave cleanly instead of the
# SIGKILL that used to end it.
# TimeoutStopSec must stay ABOVE that window: when it expires systemd stops waiting for ExecStop
# and starts killing the unit's own cgroup, which cuts the `docker run` client off mid-stop.
ExecStop=/usr/bin/docker stop -t 30 pepin-ros
TimeoutStopSec=45
# The nodes are docker's children, not this cgroup's: the only process systemd owns here is the
# `docker run` client, and it must not be signalled while ExecStop is still stopping the
# container. mixed = SIGTERM to that client alone, SIGKILL to the rest only after the timeout.
KillMode=mixed
SuccessExitStatus=137
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
