[Unit]
Description=Pepin ROS 2 stack (sensors, bridges, Foxglove; Nav2 started separately) in Docker
After=docker.service pepin-base.service pepin-tof.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
Requires=docker.service
Wants=pepin-base.service pepin-tof.service

[Service]
# PEPIN_NAV=true in /etc/default/pepin-ros starts Nav2 at boot too (one launch process for both).
EnvironmentFile=-/etc/default/pepin-ros
Environment=PEPIN_NAV=false
# Online SLAM: Nav2 on the map the laptop's RTAB-Map builds while the cart drives (implies
# nav; no map_server, no tracker). ros/thin.sh slam writes it together with the bridge's
# slam allow-list, because the two may not disagree about who publishes /map.
Environment=PEPIN_SLAM=false
# The old lidar-only mapper (slam_toolbox, ros/mode.sh slam_toolbox): builds a map to SAVE,
# never drives on it. Never together with PEPIN_NAV or PEPIN_SLAM: two map -> odom publishers.
Environment=PEPIN_SLAM_TOOLBOX=false
Environment=PEPIN_MAP=/maps/20260903_182653_lap3_loop.yaml
Environment=PEPIN_CPP_BRIDGE=false
Environment=PEPIN_IMU=false
# The EKF (ros/params/ekf.yaml) fuses whatever odometry sources are alive and owns
# odom -> base_link; it does NOT need the IMU, only the C++ bridge. Off, the bridge publishes
# that transform from the wheels alone and there is no /odometry/filtered for the relocalizer.
Environment=PEPIN_EKF=true
# The lidar's own scan-to-scan odometry (rf2o) as a twist for that filter, odom3 in the same file
# (ros/feature.sh laser_odom on|off). A source, not a precondition: off, the filter runs on the
# wheels, the gyro and the camera exactly as before. It publishes no transform.
Environment=PEPIN_LASER_ODOM=true
Environment=PEPIN_TOF=false
# The neck's encoders and the live camera transform (ros/feature.sh neck on|off); the laptop's
# SLAM must then start with ros/laptop.sh vslam --neck, or two nodes publish base_link -> camera_link.
Environment=PEPIN_NECK=false
# all: the whole stack here; board: the reflex half, with the planner and goal server on the laptop (ros/laptop.sh)
Environment=PEPIN_SIDE=all
# cyclone (the default): CycloneDDS and the zenoh-bridge sidecar, exactly as before. zenoh:
# rmw_zenoh_cpp against pepin-zrouter.service, and pepin-bridge.service stands down. Set in
# /etc/default/pepin-ros so it survives a reboot; ros/run.sh turns it into the container's image
# and environment.
Environment=PEPIN_RMW=zenoh
# WHO OWNS map -> odom. rtabmap (the default since 2026-09-22): the laptop's RTAB-Map publishes
# that transform and the board's lidar tracker (pepin_bringup.relocalizer) does not start here at
# all. tracker: the stack of before, where the relocalizer owns the edge and republishes the grid
# it adopted as /map_tracked. Set in /etc/default/pepin-ros so it survives a reboot; ros/run.sh
# turns it into the container's environment, and ros/lib.sh holds the same default for the shell.
Environment=PEPIN_LOCALIZER=rtabmap
# One container per boot; --rm so a stale one never blocks the name. The image is built by ros/build.sh.
# No RTC on this board: it boots with yesterday's clock and NTP jumps it hours forward a minute
# later; every "seconds since the last reading" check in Nav2 then sees stale data and the first
# goal dies (2026-09-07 11:45). Wait for the sync, but never forever: an offline robot still starts.
ExecStartPre=-/bin/sh -c 'for i in $$(seq 1 90); do [ "$$(timedatectl show -p NTPSynchronized --value)" = yes ] && exit 0; sleep 1; done; echo "clock not synced after 90 s, starting anyway"'
# The previous container's log is the only record of what Nav2 did; keep it before the rm.
ExecStartPre=-/bin/sh -c 'mkdir -p /root/pepin-ros/logs && /usr/bin/docker logs pepin-ros > /root/pepin-ros/logs/$$(date +%%Y%%m%%d_%%H%%M%%S).log 2>&1'
ExecStartPre=-/usr/bin/docker rm -f pepin-ros
# run.sh mounts the code from /root/pepin-ros (see it): edits reach the robot via ros/sync.sh, no rebuild.
ExecStart=/root/pepin-ros/run.sh ros2 launch pepin_bringup bringup.launch.py nav:=${PEPIN_NAV} slam:=${PEPIN_SLAM} slam_toolbox:=${PEPIN_SLAM_TOOLBOX} map:=${PEPIN_MAP} base_bridge_cpp:=${PEPIN_CPP_BRIDGE} imu:=${PEPIN_IMU} ekf:=${PEPIN_EKF} laser_odom:=${PEPIN_LASER_ODOM} tof:=${PEPIN_TOF} neck:=${PEPIN_NECK} side:=${PEPIN_SIDE}
# ros2 launch needs more than 5 s to bring a dozen nodes down on this board; a SIGKILL (137)
# after the grace period is still a normal stop, not a failure.
# The container's stop signal is SIGINT (ros/run.sh, ros/Dockerfile), which the launch answers by
# shutting its nodes down — the 30 s here is the launch's own sigterm_timeout, so on a
# `systemctl restart pepin-ros` every node gets the whole window to finish its write (the run
# recorder's tape, /maps/last_pose.json) instead of the SIGKILL that used to end it.
# TimeoutStopSec must stay ABOVE that window: when it expires systemd stops waiting for ExecStop
# and starts killing the unit's own cgroup, which cuts the `docker run` client off mid-stop.
ExecStop=/usr/bin/docker stop -t 30 pepin-ros
TimeoutStopSec=45
# The nodes are docker's children, not this cgroup's: the only process systemd owns here is the
# `docker run` client, and it must not be signalled while ExecStop is still stopping the
# container. mixed = SIGTERM to that client alone, SIGKILL to the rest only after the timeout.
KillMode=mixed
SuccessExitStatus=137
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
