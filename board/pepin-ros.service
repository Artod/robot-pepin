[Unit]
Description=Pepin ROS 2 stack (sensors, bridges, Foxglove; Nav2 started separately) in Docker
After=docker.service pepin-base.service pepin-tof.service
Requires=docker.service
Wants=pepin-base.service pepin-tof.service

[Service]
# PEPIN_NAV=true in /etc/default/pepin-ros starts Nav2 at boot too (one launch process for both).
EnvironmentFile=-/etc/default/pepin-ros
Environment=PEPIN_NAV=false
Environment=PEPIN_SLAM=false
Environment=PEPIN_MAP=/maps/20260903_182653_lap3_loop.yaml
Environment=PEPIN_CPP_BRIDGE=false
Environment=PEPIN_IMU=false
# One container per boot; --rm so a stale one never blocks the name. The image is built by ros/build.sh.
# The previous container's log is the only record of what Nav2 did; keep it before the rm.
ExecStartPre=-/bin/sh -c 'mkdir -p /root/pepin-ros/logs && /usr/bin/docker logs pepin-ros > /root/pepin-ros/logs/$$(date +%%Y%%m%%d_%%H%%M%%S).log 2>&1'
ExecStartPre=-/usr/bin/docker rm -f pepin-ros
# run.sh mounts the code from /root/pepin-ros (see it): edits reach the robot via ros/sync.sh, no rebuild.
ExecStart=/root/pepin-ros/run.sh ros2 launch pepin_bringup bringup.launch.py nav:=${PEPIN_NAV} slam:=${PEPIN_SLAM} map:=${PEPIN_MAP} base_bridge_cpp:=${PEPIN_CPP_BRIDGE} imu:=${PEPIN_IMU}
# ros2 launch needs more than 5 s to bring a dozen nodes down on this board; a SIGKILL (137)
# after the grace period is still a normal stop, not a failure.
ExecStop=/usr/bin/docker stop -t 15 pepin-ros
SuccessExitStatus=137
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
