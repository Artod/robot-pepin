[Unit]
Description=Pepin zenoh bridge: the board's ROS graph over one TCP link to the laptop (side=board only)
# The bridge must come up AFTER the stack and go down and up WITH it: started first, it watches
# three thousand DDS entities disappear and reappear as the stack restarts and its zenoh runtime
# wedges — the container stays "Up", the REST admin answers nothing, no session is accepted, and
# every sample stops (2026-09-09, the whole "thin client is dead" episode). PartOf makes a
# restart of pepin-ros restart this unit too, in order. Only what the split needs crosses
# (ros/zenoh-bridge-board.json for the split, ros/zenoh-bridge-board-vision.json when the board
# drives by itself and the laptop only maps — both from pepin.deployment, chosen by
# PEPIN_BRIDGE_CONFIG, which ros/thin.sh writes with the mode): routing every parameter service
# of every node — three thousand entities, launch_ros_1 on both sides — wedged the link the
# moment a second launch joined.
After=pepin-ros.service
BindsTo=pepin-ros.service
PartOf=pepin-ros.service
StartLimitIntervalSec=0

[Service]
EnvironmentFile=-/etc/default/pepin-ros
Environment=PEPIN_SIDE=all
Environment=PEPIN_BRIDGE=off
Environment=PEPIN_BRIDGE_CONFIG=zenoh-bridge-board.json
# The bridge runs for a split stack (side=board) or when the laptop only watches and maps
# (PEPIN_BRIDGE=on: RTAB-Map and the camera on the laptop, every drive on the board — actions
# over the bridge crashed the navigation container, topics never did). Otherwise it exits.
ExecStartPre=/bin/sh -c '[ "$PEPIN_SIDE" = board ] || [ "$PEPIN_BRIDGE" = on ] || { echo "side=$PEPIN_SIDE, bridge=$PEPIN_BRIDGE: no bridge"; exit 0; }'
# Wait for the graph to settle: the tracker is the last node up.
# (pgrep, not "ros2 node list": the graph query itself takes tens of seconds on a busy board).
# Then 20 s more: a route created while a topic's writers are still appearing binds to the
# first one only — /tf routed nothing until the bridge was restarted with all three
# writers declared (2026-09-10 00:05).
ExecStartPre=/bin/sh -c '[ "$PEPIN_SIDE" = board ] || [ "$PEPIN_BRIDGE" = on ] || exit 0; for i in $(seq 1 60); do /usr/bin/docker exec pepin-ros pgrep -f pepin_bringup.relocalizer >/dev/null 2>&1 && sleep 20 && exit 0; sleep 2; done; echo "stack not up after 120 s, starting the bridge anyway"'
ExecStartPre=-/usr/bin/docker rm -f zenoh-bridge
ExecStart=/bin/sh -c '[ "$PEPIN_SIDE" = board ] || [ "$PEPIN_BRIDGE" = on ] || exec sleep infinity; exec /usr/bin/docker run --rm --name zenoh-bridge --network host -v /root/pepin-ros/$PEPIN_BRIDGE_CONFIG:/config.json:ro -e ROS_DISTRO=jazzy eclipse/zenoh-bridge-ros2dds:1.7.0 -c /config.json -d 7 -l tcp/0.0.0.0:7447 --rest-http-port 8000'
# Liveness: the REST admin answers when the zenoh runtime does. A bridge that wedges at start
# stays "Up" and answers nothing (2026-09-09); this fails the unit within 60 s so Restart=
# brings a new one — the same check ros/laptop.sh and the laptop's bridge watch make from outside.
ExecStartPost=/bin/sh -c '[ "$PEPIN_SIDE" = board ] || [ "$PEPIN_BRIDGE" = on ] || exit 0; for i in $(seq 1 30); do curl -s -m 3 http://127.0.0.1:8000/@/local/router | grep -q ros2dds && exit 0; sleep 2; done; echo "the bridge REST admin answered nothing 60 s after start: wedged, failing the unit"; exit 1'
ExecStop=-/usr/bin/docker stop -t 5 zenoh-bridge
Restart=on-failure
RestartSec=5

[Install]
# Enabled = pulled in by the stack: every start of pepin-ros starts the bridge after it.
WantedBy=pepin-ros.service
