[Unit]
Description=Assign unique I2C addresses to VL53L1X ToF sensors
# Runs once, early. pepin-tof.service Requires= this unit, so it must not order
# itself after multi-user.target: that made an ordering cycle and systemd dropped
# the ToF jobs at boot.
After=local-fs.target
Before=pepin-tof.service

[Service]
Type=oneshot
RemainAfterExit=yes
# The script checks that 0x30, 0x31 and 0x32 answer and runs the XSHUT sequence again when one
# does not (about 3 s an attempt). Its outcome is also appended to /var/log/tof_init.log: the
# journal is rotated by the stack's own logging within hours. It exits 0 on a partial result so
# that pepin-tof (Requires= this unit) still streams the sensors that answer.
Environment=TOF_INIT_ATTEMPTS=3
ExecStart=/usr/local/bin/tof_init.sh

[Install]
WantedBy=multi-user.target
