# Local assistant config
.claude/
CLAUDE.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# OS
.DS_Store

# Local data and logs
data/
logs/
*.log

# One-off analyses and probes (readable locally, never published)
scratch/
ros/pepin_src/
ros/maps/rec/
ros/maps/*.posegraph
ros/maps/*.data
ros/maps/*_throttle*
.coverage
ros/maps/rtabmap*.db*
# left behind by the retired ros/laptop.sh start (the board's side and map)
ros/.mode
ros/.map
ros/maps/last_pose.json

# written by the depth node at run time (the persisted affine law)
ros/maps/depth_law.json
ros/maps/world_*.npz
# the volume's own snapshot and the pgm/yaml pair exported from it (the board's cache of the
# one map); written at run time, never edited by hand
ros/maps/*.world.npz
ros/maps/*.world.pgm
ros/maps/*.world.yaml
# and the suffixed copies kept by hand or by older restart.sh --fresh runs
ros/maps/world_*.npz.*
ros/maps/*.world.npz.*
ros/maps/depth_law.json.*

# The replay stand's engine build, prepared drives and snapshots (ros/replay.sh)
ros/replay/.cache/

# Model checkpoints: 40 MB of binary, fetched not committed (RAFT-Stereo's
# download_models.sh; see src/pepin/vendor/raft_stereo/__init__.py)
models/

# the simulator's run directory: tapes, scores, the goal server's planner pick (ros/sim.sh)
ros/sim/run/

# API keys of the LLM test loop (scratch/llm): never tracked
.env

# written by the depth node at run time (the stereo law witness), like depth_law.json
ros/maps/depth_law_stereo.json
# editor settings
.vscode/
