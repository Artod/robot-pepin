#!/bin/bash
# The whole suite before anything leaves the machine: slow simulations included, in parallel
# (pytest-xdist: 6 workers, the Mac's performance cores; worksteal, so the long simulated drives
# do not queue behind one worker), and the coverage floor.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: unit tests, slow included, coverage floor ($(cat tests/coverage_floor.txt)%)"
uv run pytest tests/unit -q --no-header -p no:cacheprovider -n 6 --dist worksteal \
    --cov=src/pepin --cov-report=term:skip-covered --cov-fail-under="$(cat tests/coverage_floor.txt)"
