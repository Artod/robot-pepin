#!/bin/bash
# The commit gate, seconds not minutes (CLAUDE.md rule 14): shell syntax, ruff, mypy (its cache
# keeps it to about a second). No tests here: `uv run pytest tests/unit -q` green is the done
# criterion of a task, run while working; the whole suite, `slow` included, runs in
# .githooks/pre-push with the coverage floor.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: shell syntax (ros/*.sh, board/*.sh)"
for script in ros/*.sh board/*.sh; do bash -n "$script"; done
echo "pre-commit: ruff"
uv run ruff check . --quiet
uv run ruff format --check . --quiet
echo "pre-commit: mypy"
uv run mypy --no-error-summary
