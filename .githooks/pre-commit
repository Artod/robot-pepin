#!/bin/bash
# Fast gate on every commit: shell syntax, ruff, mypy (its cache keeps it to seconds), the
# millisecond tests. Simulated drives, loop closures and socket tests are marked `slow` and run
# in .githooks/pre-push (with the coverage floor) and on demand: uv run pytest -m slow.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: shell syntax (ros/*.sh, board/*.sh)"
for script in ros/*.sh board/*.sh; do bash -n "$script"; done
echo "pre-commit: ruff"
uv run ruff check . --quiet
uv run ruff format --check . --quiet
echo "pre-commit: mypy"
uv run mypy --no-error-summary
echo "pre-commit: fast unit tests"
uv run pytest tests/unit -q --no-header -p no:cacheprovider -m "not slow"
