#!/bin/sh
# Pre-commit gate: style, types, and fast unit tests. Hardware tests are
# excluded on purpose — they need the robot. Enable once per clone with:
#     git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
echo "pre-commit: ruff"
uv run ruff check . --quiet
uv run ruff format --check . --quiet
echo "pre-commit: mypy"
uv run mypy --no-error-summary
echo "pre-commit: unit tests"
uv run pytest tests/unit -q --no-header -p no:cacheprovider
