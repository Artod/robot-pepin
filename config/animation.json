      "note": "a single sudden nod on the stressed word; now and then a beat of the hand (slow at the first caps)",
      "variants": [
        {"weight": 3.0, "steps": [
          {"atom": "head_nod", "at_s": [-0.15, 0.0], "params": {"amp_deg": [4.0, 6.0], "period_s": [0.4, 0.45]}}
        ]},
        {"weight": 1.0, "steps": [
          {"atom": "arm_beat", "at_s": [-0.2, 0.0]},
          {"atom": "head_nod", "at_s": [-0.15, 0.0], "p": 0.5, "params": {"amp_deg": [2.0, 4.0]}}
        ]}
      ]
    },
    "surprise": {
      "cooldown_s": 20.0,
      "note": "an O mouth just before, the head lifted on the word, the arm raised now and then, a slow settle",
      "variants": [
        {"steps": [
          {"atom": "face", "at_s": [-0.15, -0.05], "params": {"name": "surprised", "hold_s": [1.5, 2.0]}},
