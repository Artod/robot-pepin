      "note": "yes: a nod or two, a smile now and then",
      "variants": [
        {"steps": [
          {"atom": "head_nod", "at_s": [-0.1, 0.0], "params": {"amp_deg": [4.0, 6.0], "repeats": [1, 2]}},
          {"atom": "face", "p": 0.5, "params": {"name": "smile", "hold_s": [1.5, 2.0]}}
        ]}
      ]
    },
    "disagreement": {
      "cooldown_s": 8.0,
      "note": "no: a shake or two, a flat mouth, the wrist so-so now and then",
      "variants": [
        {"steps": [
          {"atom": "head_shake", "at_s": [-0.1, 0.0], "params": {"amp_deg": [5.0, 9.0]}},
          {"atom": "face", "p": 0.7, "params": {"name": "flat", "hold_s": [1.5, 2.0]}},
          {"atom": "wrist_turn", "at_s": [0.2, 0.4], "p": 0.2}
        ]}
      ]
    },
    "shrug": {
      "cooldown_s": 15.0,
      "note": "who knows: the hand opened, the head down a little and aside, a flat or thinking mouth",
      "variants": [
        {"steps": [
          {"atom": "arm_flourish", "at_s": [-0.1, 0.1], "p": 0.7},
          {"atom": "head_drop", "params": {"amp_deg": [2.0, 3.0]}},
          {"atom": "head_glance", "p": 0.5, "params": {"side_deg": [4.0, 6.0], "up_deg": [0.0, 1.0]}},
          {"atom": "face", "params": {"name": ["flat", "thinking"], "hold_s": [1.5, 2.5]}}
        ]}
      ]
    },
    "evil_click": {
      "cooldown_s": 300.0,
      "note": "the mischievous one: the head lowered and a clenched grin first, then three clicks of the gripper; marker only, once in five minutes",
      "variants": [
        {"steps": [
          {"atom": "head_drop", "at_s": [-0.5, -0.3], "params": {"amp_deg": [3.0, 5.0], "period_s": [2.5, 3.0]}},
          {"atom": "face", "at_s": [-0.5, -0.3], "params": {"name": ["clenched", "grin"], "hold_s": [3.0, 3.5]}},
          {"atom": "body_rock", "at_s": [-0.6, -0.4]},
          {"atom": "arm_pose", "at_s": [-1.4, -1.2], "p": 0.6, "params": {"pose": "raised", "hold_s": [3.6, 4.0]}},
          {"atom": "gripper_click", "params": {"repeats": 3, "period_s": [1.0, 1.1]}}
        ]}
      ]
    },
    "sympathy": {
      "cooldown_s": 20.0,
      "note": "small and slow: the head down, a worried mouth, no arm",
      "variants": [
        {"steps": [
          {"atom": "head_drop", "params": {"amp_deg": [4.0, 6.0], "period_s": [2.5, 3.0]}},
          {"atom": "face", "params": {"name": "worried", "hold_s": [2.5, 3.0]}}
        ]}
      ]
    }
  },
  "idle": [
    {"part": "head", "atoms": ["head_drift"], "every_s": [20.0, 60.0], "when": "conversation"}
  ],
  "moments": {
    "slow_tool": "thinking",
    "note": "a moment of the robot (pepin.expression.conversation) -> the composition it performs, under the caps"
  }
}
