+
+void ROS2Visualizer::callback_mask(const sensor_msgs::msg::Image::SharedPtr msg) {
+  cv_bridge::CvImageConstPtr cv_ptr;
+  try {
+    cv_ptr = cv_bridge::toCvShare(msg, sensor_msgs::image_encodings::MONO8);
+  } catch (cv_bridge::Exception &e) {
+    PRINT_ERROR("cv_bridge exception (mask): %s", e.what());
+    return;
+  }
+  double timestamp = cv_ptr->header.stamp.sec + cv_ptr->header.stamp.nanosec * 1e-9;
+  std::lock_guard<std::mutex> lck(mask_mtx);
+  masks_by_time[timestamp] = cv_ptr->image.clone();
+  while (masks_by_time.size() > 30) {
+    masks_by_time.erase(masks_by_time.begin());
+  }
+}
+
+cv::Mat ROS2Visualizer::frame_mask(double timestamp, int rows, int cols) {
+  std::lock_guard<std::mutex> lck(mask_mtx);
+  auto it = masks_by_time.lower_bound(timestamp - 0.001);
+  if (it != masks_by_time.end() && std::abs(it->first - timestamp) <= 0.001 && it->second.rows == rows &&
+      it->second.cols == cols) {
+    return it->second;
+  }
+  return cv::Mat::zeros(rows, cols, CV_8UC1);
+}
