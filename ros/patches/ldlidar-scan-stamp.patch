+void LdLidarComponent::reportSweepTiming(double sweep_s, double pickup_lag_s, int64_t mid_ns)
+{
+  // pepin: once a minute, how the sweeps were dated: the stamp mode, the sweep duration and the
+  // pickup lag (how late upstream's stamp is), the sweeps the polling loop never picked up.
+  if (sweep_s > 0.0) {
+    const double gap_s = static_cast<double>(mid_ns - _prevMidNs) * 1e-9;
+    if (_prevMidNs > 0 && gap_s > 1.5 * sweep_s) {
+      _lostSweeps += std::lround(gap_s / sweep_s) - 1;
+    }
+    _prevMidNs = mid_ns;
+    _sweepMs.push_back(sweep_s * 1e3);
+    _pickupLagMs.push_back(pickup_lag_s * 1e3);
+  } else {
+    ++_untimedSweeps;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  const double elapsed = std::chrono::duration<double>(now - _reportAt).count();
+  if (elapsed < 60.0) {
+    return;
+  }
+  auto pct = [](std::vector<double> v, double p) {
+    if (v.empty()) {
+      return std::nan("");
+    }
+    const auto k = static_cast<size_t>(p * static_cast<double>(v.size() - 1) + 0.5);
+    std::nth_element(v.begin(), v.begin() + static_cast<std::ptrdiff_t>(k), v.end());
+    return v[k];
+  };
+  const size_t sweeps = _sweepMs.size() + static_cast<size_t>(_untimedSweeps);
+  RCLCPP_INFO(
+    get_logger(),
+    "scan timing: stamp %s; %zu sweeps in %.0f s (%.2f Hz); sweep %.1f ms [p10 %.1f, p90 %.1f]; "
+    "picked up %.0f ms [p10 %.0f, p90 %.0f] after the last point; %ld sweeps lost, %ld without "
+    "packet timing",
+    _stampMid ? "mid" : "end", sweeps, elapsed, static_cast<double>(sweeps) / elapsed,
+    pct(_sweepMs, 0.5), pct(_sweepMs, 0.1), pct(_sweepMs, 0.9), pct(_pickupLagMs, 0.5),
+    pct(_pickupLagMs, 0.1), pct(_pickupLagMs, 0.9), _lostSweeps, _untimedSweeps);
+  _sweepMs.clear();
+  _pickupLagMs.clear();
+  _lostSweeps = 0;
+  _untimedSweeps = 0;
+  _reportAt = now;
 }
 
