+/// How much IMU history the reset keeps (s): a new manager's static window (init_window_time + 0.1) and the seed's
+const double IMU_RING_KEEP_S = 3.0;
+
+/// How much bias history the reset keeps (s): beyond seed_bias_max_age_s's range
+const double BIAS_KEEP_S = 300.0;
+
+/// The rotation from a gravity frame (z up) to the IMU whose accelerometer reads gravity_inI at rest: R_GtoI's third
+/// column is the measured up; the yaw is arbitrary (the VIO's global yaw is unobservable). ov_init::InitializerHelper::
+/// gram_schmidt, as StaticInitializer uses it.
+Eigen::Matrix3d gravity_aligned(const Eigen::Vector3d &gravity_inI) {
+  Eigen::Vector3d z_axis = gravity_inI / gravity_inI.norm();
+  Eigen::Vector3d e_1(1.0, 0.0, 0.0);
+  Eigen::Vector3d e_2(0.0, 1.0, 0.0);
+  Eigen::Vector3d x_axis = (std::fabs(e_1.dot(z_axis)) < std::fabs(e_2.dot(z_axis))) ? z_axis.cross(e_1) : z_axis.cross(e_2);
+  x_axis = x_axis / x_axis.norm();
+  Eigen::Vector3d y_axis = z_axis.cross(x_axis);
+  y_axis = y_axis / y_axis.norm();
+  Eigen::Matrix3d R_GtoI;
+  R_GtoI.block(0, 0, 3, 1) = x_axis;
+  R_GtoI.block(0, 1, 3, 1) = y_axis;
+  R_GtoI.block(0, 2, 3, 1) = z_axis;
+  return R_GtoI;
+}
