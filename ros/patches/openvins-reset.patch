+//===================================================================================
+// In-process reset and warm seed (ros/patches/openvins-reset.patch)
+//===================================================================================
+
+bool ROS2Visualizer::request_reset(const std::string &why, std::string &answer) {
+  {
+    std::lock_guard<std::mutex> lck(seed_note_mtx);
+    reset_why = why;
+  }
+  reset_pending = true;
+  return try_reset(answer);
+}
+
+bool ROS2Visualizer::try_reset(std::string &answer) {
+
+  // No update thread inside (it holds the queue's lock while it feeds _app), no visualize thread reading _app; the
+  // executor's callbacks (IMU, cameras, this service) are one mutually exclusive group, so none of them runs either
+  std::lock_guard<std::mutex> lck_queue(camera_queue_mtx);
+  std::lock_guard<std::mutex> lck_app(app_mtx);
+  if (_app->init_thread_running()) {
+    answer = "pending: the initialiser's thread is running; made at the first IMU sample that finds it done";
+    return false;
+  }
+
+  // A new manager from the same parsed options (ModalAI voxl-open-vins-server's hard reset): new state, trackers,
+  // feature database, propagator, updaters and initialiser; fed the last IMU samples so its propagator and its static
+  // window start full
+  VioManagerOptions params = _app->get_params();
+  // Its fallback initialiser is dynamic (in motion) only with seed_dyn_init: the config's init_dyn_use is the cold start's
+  params.init_options.init_dyn_use = param("seed_dyn_init", params.init_options.init_dyn_use ? 1.0 : 0.0) > 0.5;
+  auto fresh = std::make_shared<VioManager>(params);
+  double last_imu = -1;
+  {
+    std::lock_guard<std::mutex> lck(imu_ring_mtx);
+    for (const auto &sample : imu_ring) {
+      fresh->feed_measurement_imu(sample);
+    }
+    if (!imu_ring.empty()) {
+      last_imu = imu_ring.back().timestamp;
+    }
+  }
+  bool warm = param("seed_warm", 1.0) > 0.5;
+  if (warm) {
+    VioManager *manager = fresh.get(); // the seed is owned by the manager it seeds
+    fresh->set_warm_seed(
+        [this, manager](double timestamp, double &seed_time, Eigen::Matrix<double, 16, 1> &imustate, Eigen::Matrix<double, 15, 15> &covariance) {
+          return warm_seed(manager, timestamp, seed_time, imustate, covariance);
+        });
+  }
+  _app = fresh;
+  epoch++;
+  reset_pending = false;
+  warm_armed = warm;
+  reset_imu_time = last_imu;
+  reset_first_frame = -1;
+  was_initialized = false;
+  std::string why;
+  {
+    std::lock_guard<std::mutex> lck(seed_note_mtx);
+    seed_note = warm ? "armed" : "seed_warm off: the standard initialiser";
+    why = reset_why;
+  }
+  answer = format("reset %d made (%s) at IMU time %.3f: %s", epoch.load(), why.c_str(), last_imu,
+                  warm ? "warm seed armed" : "the standard initialiser");
+  PRINT_INFO(YELLOW "[reset]: %s; poses now in %s\n" RESET, answer.c_str(), global_frame().c_str());
+  return true;
+}
+
+bool ROS2Visualizer::warm_seed(VioManager *manager, double timestamp, double &seed_time, Eigen::Matrix<double, 16, 1> &imustate,
+                               Eigen::Matrix<double, 15, 15> &covariance) {
+  if (!warm_armed) {
+    return false;
+  }
+  auto note = [this](const std::string &text) {
+    std::lock_guard<std::mutex> lck(seed_note_mtx);
+    seed_note = text;
+  };
+  auto disarm = [&](const std::string &why) {
+    warm_armed = false;
+    note("no warm seed: " + why + "; the standard initialiser");
+    PRINT_WARNING(YELLOW "[reset]: no warm seed: %s; the standard initialiser (static at rest%s)\n" RESET, why.c_str(),
+                  manager->get_params().init_options.init_dyn_use ? ", dynamic in motion" : "");
+    return false;
+  };
+  if (reset_first_frame < 0) {
+    reset_first_frame = timestamp;
+  }
+  double t_off = manager->get_state()->_calib_dt_CAMtoIMU->value()(0);
+  double t_imu = timestamp + t_off;
+
+  // The biases: the newest healthy snapshot taken seed_bias_lag_s before the reset (a divergence corrupts them before
+  // anyone calls it one), at most seed_bias_max_age_s old at this frame; past that age the standard initialiser alone
+  BiasSnapshot snap;
+  bool have = false;
+  {
+    std::lock_guard<std::mutex> lck(bias_mtx);
+    double cut = reset_imu_time - param("seed_bias_lag_s", 2.0);
+    for (auto it = bias_snapshots.rbegin(); it != bias_snapshots.rend(); ++it) {
+      if (it->timestamp <= cut) {
+        snap = *it;
+        have = true;
+        break;
+      }
+    }
+  }
+  if (!have) {
+    return disarm("no healthy bias snapshot before the reset");
+  }
+  double age = t_imu - snap.timestamp;
+  double max_age = param("seed_bias_max_age_s", 60.0);
+  if (age > max_age) {
+    return disarm(format("the biases are %.0f s old (over %.0f)", age, max_age));
+  }
+  Eigen::Vector3d bg = snap.bias.head<3>();
+  Eigen::Vector3d ba = snap.bias.tail<3>();
+
+  // A picture first: persistent tracks (a seed into the dark would only propagate the IMU, which is what diverged)
+  int min_features = (int)param("seed_min_features", 15.0);
+  size_t track_frames = (size_t)std::max(1.0, param("seed_track_frames", 3.0));
+  int tracked = manager->num_tracked(0, track_frames);
+  if (tracked < min_features) {
+    note(format("waiting: %d tracks of %d+ frames (under %d)", tracked, (int)track_frames, min_features));
+    return false;
+  }
+
+  // Gravity in the IMU's frame at the frame's time: the window's specific force (kept ba removed), each sample turned
+  // into the end's frame by the bias-corrected gyro, averaged (a pan or a turn moves gravity in the IMU's axes; the
+  // cart's vibration averages out); its spread over sqrt(n) plus seed_accel_allow_m_s2 of unmodelled acceleration,
+  // over g, is the tilt's sigma
+  double window = param("seed_accel_window_s", 0.5);
+  std::vector<ov_core::ImuData> samples;
+  double t_before = -1;
+  {
+    std::lock_guard<std::mutex> lck(imu_ring_mtx);
+    for (const auto &sample : imu_ring) {
+      if (sample.timestamp > t_imu - window && sample.timestamp <= t_imu) {
+        samples.push_back(sample);
+      }
+      if (sample.timestamp < t_imu - 1e-4) {
+        t_before = sample.timestamp;
+      }
+    }
+  }
+  if (samples.size() < 10 || t_before < 0) {
+    note(format("waiting: %d IMU samples in the %.2f s before the frame", (int)samples.size(), window));
+    return false;
+  }
+  double w_max = 0.0;
+  Eigen::Matrix3d C = Eigen::Matrix3d::Identity(); // sample i's frame -> the end's frame
+  std::vector<Eigen::Vector3d> turned(samples.size());
+  turned.back() = samples.back().am - ba;
+  for (int i = (int)samples.size() - 2; i >= 0; i--) {
+    Eigen::Vector3d w = samples.at(i).wm - bg;
+    w_max = std::max(w_max, w.norm());
+    double dt = samples.at(i + 1).timestamp - samples.at(i).timestamp;
+    C = C * ov_core::exp_so3(-w * dt);
+    turned.at(i) = C * (samples.at(i).am - ba);
+  }
+  double w_limit = param("seed_gyro_max_rad_s", 1.0);
+  if (w_max > w_limit) {
+    note(format("waiting: turning (%.2f rad/s, over %.2f)", w_max, w_limit));
+    return false;
+  }
+  Eigen::Vector3d f = Eigen::Vector3d::Zero();
+  for (const auto &a : turned) {
+    f += a;
+  }
+  f /= (double)turned.size();
+  double spread = 0.0;
+  for (const auto &a : turned) {
+    spread += (a - f).squaredNorm();
+  }
+  spread = std::sqrt(spread / (double)(turned.size() - 1));
+  double gravity = manager->get_params().gravity_mag;
+  double g_tol = param("seed_g_tol_m_s2", 0.5);
+  if (std::fabs(f.norm() - gravity) > g_tol) {
+    note(format("waiting: |f| %.2f m/s^2 is %.2f from gravity (over %.2f)", f.norm(), f.norm() - gravity, g_tol));
+    return false;
+  }
+  Eigen::Matrix3d R_GtoI = gravity_aligned(f);
+  double sigma_tilt = (spread / std::sqrt((double)turned.size()) + param("seed_accel_allow_m_s2", 0.3)) / gravity;
+
+  // The velocity from outside: the EKF's twist carried to the IMU in its own axes (pepin_bringup.vio_keeper), near the frame
+  VelocitySeed seed;
+  {
+    std::lock_guard<std::mutex> lck(velocity_seed_mtx);
+    for (const auto &candidate : velocity_seeds) {
+      if (seed.timestamp < 0 || std::fabs(candidate.timestamp - t_imu) < std::fabs(seed.timestamp - t_imu)) {
+        seed = candidate;
+      }
+    }
+  }
+  if (seed.timestamp < 0) {
+    note("waiting: no velocity on /vio/seed_twist");
+    return false;
+  }
+  double v_age = t_imu - seed.timestamp;
+  double v_max_age = param("seed_vel_max_age_s", 0.2);
+  if (std::fabs(v_age) > v_max_age) {
+    note(format("waiting: the velocity seed is %.2f s from the frame (over %.2f)", v_age, v_max_age));
+    return false;
+  }
+  Eigen::Vector3d v_G = R_GtoI.transpose() * seed.v_I;
+  double sigma_v = param("seed_sigma_v_m_s", 0.03);
+  Eigen::Matrix3d P_v = R_GtoI.transpose() * seed.covariance * R_GtoI;
+  P_v = 0.5 * (P_v + P_v.transpose()) + sigma_v * sigma_v * Eigen::Matrix3d::Identity();
+
+  // The state [q_GtoI, p_IinG, v_IinG, bg, ba] and its covariance (q, p, v, bg, ba): the position and the yaw are the
+  // new frame's gauge (the relay re-anchors), the biases' covariance their snapshot's plus the random walk since
+  imustate.block(0, 0, 4, 1) = ov_core::rot_2_quat(R_GtoI);
+  imustate.block(4, 0, 3, 1) = Eigen::Vector3d::Zero();
+  imustate.block(7, 0, 3, 1) = v_G;
+  imustate.block(10, 0, 3, 1) = bg;
+  imustate.block(13, 0, 3, 1) = ba;
+  covariance.setZero();
+  double sigma_q = std::max(param("seed_sigma_q_rad", 0.02), sigma_tilt);
+  double sigma_p = param("seed_sigma_p_m", 0.05);
+  covariance.block(0, 0, 3, 3) = sigma_q * sigma_q * Eigen::Matrix3d::Identity();
+  covariance.block(3, 3, 3, 3) = sigma_p * sigma_p * Eigen::Matrix3d::Identity();
+  covariance.block(6, 6, 3, 3) = P_v;
+  Eigen::Matrix<double, 6, 6> P_b = snap.covariance;
+  const auto &noises = manager->get_params().imu_noises;
+  P_b.block(0, 0, 3, 3) += noises.sigma_wb * noises.sigma_wb * std::max(age, 0.0) * Eigen::Matrix3d::Identity();
+  P_b.block(3, 3, 3, 3) += noises.sigma_ab * noises.sigma_ab * std::max(age, 0.0) * Eigen::Matrix3d::Identity();
+  double inflation = param("seed_bias_inflation", 1.0);
+  P_b *= inflation * inflation;
+  double floor_bg = param("seed_sigma_bg_floor", 0.005);
+  double floor_ba = param("seed_sigma_ba_floor", 0.02);
+  for (int i = 0; i < 3; i++) {
+    P_b(i, i) = std::max(P_b(i, i), floor_bg * floor_bg);
+    P_b(3 + i, 3 + i) = std::max(P_b(3 + i, 3 + i), floor_ba * floor_ba);
+  }
+  covariance.block(9, 9, 6, 6) = 0.5 * (P_b + P_b.transpose());
+
+  // At the last IMU sample before the frame (camera clock), so the frame gets the first clone
+  seed_time = std::min(t_before - t_off, timestamp - 1e-3);
+  warm_armed = false;
+  warm_seeds++;
+  std::string text = format("warm %.2f s after the reset's first frame: %d tracks, biases %.1f s old (bg %.4f ba %.3f), |v| %.3f m/s "
+                            "(seed %+.2f s from the frame, sigma %.3f), tilt sigma %.1f deg (spread %.2f, %d samples), gyro %.2f",
+                            timestamp - reset_first_frame, tracked, age, bg.norm(), ba.norm(), seed.v_I.norm(), v_age,
+                            std::sqrt(P_v.trace() / 3.0), sigma_q * 180.0 / M_PI, spread, (int)turned.size(), w_max);
+  note(text);
+  PRINT_INFO(GREEN "[reset]: %s\n" RESET, text.c_str());
+  return true;
+}
+
+void ROS2Visualizer::take_bias_snapshot() {
+  if (!_app->initialized()) {
+    return;
+  }
+  std::shared_ptr<State> state = _app->get_state();
+  int used = (int)_app->get_good_features_MSCKF().size() + _app->num_slam();
+  bool zupt = _app->last_was_zupt();
+  if (!zupt && used < (int)param("snapshot_min_features", 20.0)) {
+    return;
+  }
+  Eigen::Matrix<double, 6, 1> bias;
+  bias << state->_imu->bias_g(), state->_imu->bias_a();
+  // ModalAI's gate on a kept bias (|bg| 0.2 rad/s, |ba| 1.0 m/s^2, sigmas 0.05 and 0.5): beyond it, the divergence's
+  if (bias.head<3>().norm() > 0.2 || bias.tail<3>().norm() > 1.0) {
+    return;
+  }
+  std::vector<std::shared_ptr<ov_type::Type>> vars = {state->_imu->bg(), state->_imu->ba()};
+  Eigen::MatrixXd P = StateHelper::get_marginal_covariance(state, vars);
+  if (P.rows() != 6 || P.cols() != 6 || !P.allFinite()) {
+    return;
+  }
+  if (std::sqrt(P.block(0, 0, 3, 3).trace() / 3.0) > 0.05 || std::sqrt(P.block(3, 3, 3, 3).trace() / 3.0) > 0.5) {
+    return;
+  }
+  BiasSnapshot snap;
+  snap.timestamp = state->_timestamp + state->_calib_dt_CAMtoIMU->value()(0);
+  snap.bias = bias;
+  snap.covariance = P;
+  std::lock_guard<std::mutex> lck(bias_mtx);
+  // about two a second: the newest replaces the last one while the one before that is under 0.5 s older
+  // (replacing while the LAST was younger than 0.5 s kept one entry moving forward for good, 2026-10-06)
+  size_t n = bias_snapshots.size();
+  if (n >= 2 && snap.timestamp - bias_snapshots.at(n - 2).timestamp < 0.5) {
+    bias_snapshots.back() = snap;
+  } else {
+    bias_snapshots.push_back(snap);
+  }
+  while (!bias_snapshots.empty() && bias_snapshots.front().timestamp < snap.timestamp - BIAS_KEEP_S) {
+    bias_snapshots.pop_front();
+  }
+}
+
+void ROS2Visualizer::publish_health(double timestamp) {
+  std::shared_ptr<State> state = _app->get_state();
+  bool init = _app->initialized();
+  if (init && !was_initialized && epoch > 0) {
+    std::lock_guard<std::mutex> lck(seed_note_mtx);
+    if (seed_note.rfind("warm", 0) != 0) {
+      standard_inits++;
+      seed_note = "standard initialiser";
+    }
+  }
+  was_initialized = init;
+
+  // The camera's rotation since the last frame: the largest bias-corrected gyro rate (a head swing blurs the picture)
+  double t_off = state->_calib_dt_CAMtoIMU->value()(0);
+  double t_imu = timestamp + t_off;
+  Eigen::Vector3d bg = Eigen::Vector3d::Zero();
+  double bias_age = -1;
+  {
+    std::lock_guard<std::mutex> lck(bias_mtx);
+    if (!bias_snapshots.empty()) {
+      bg = bias_snapshots.back().bias.head<3>();
+      bias_age = t_imu - bias_snapshots.back().timestamp;
+    }
+  }
+  if (init) {
+    bg = state->_imu->bias_g();
+  }
+  double gyro = 0.0;
+  {
+    std::lock_guard<std::mutex> lck(imu_ring_mtx);
+    double from = (last_health_imu_time > 0 && last_health_imu_time < t_imu) ? last_health_imu_time : t_imu - 0.1;
+    for (const auto &sample : imu_ring) {
+      if (sample.timestamp > from && sample.timestamp <= t_imu) {
+        gyro = std::max(gyro, (sample.wm - bg).norm());
+      }
+    }
+  }
+  last_health_imu_time = t_imu;
+
+  diagnostic_msgs::msg::DiagnosticStatus msg;
+  msg.name = "ov_msckf";
+  msg.hardware_id = global_frame();
+  msg.level = init ? diagnostic_msgs::msg::DiagnosticStatus::OK : diagnostic_msgs::msg::DiagnosticStatus::WARN;
+  std::string seed;
+  {
+    std::lock_guard<std::mutex> lck(seed_note_mtx);
+    seed = seed_note;
+  }
+  msg.message = init ? "initialized" : ("initialising" + (seed.empty() ? std::string() : ": " + seed));
+  auto value = [&msg](const std::string &key, const std::string &text) {
+    diagnostic_msgs::msg::KeyValue pair;
+    pair.key = key;
+    pair.value = text;
+    msg.values.push_back(pair);
+  };
+  value("t", format("%.6f", timestamp));
+  value("epoch", std::to_string(epoch.load()));
+  value("initialized", init ? "1" : "0");
+  value("tracked", std::to_string(_app->num_tracked(0)));
+  value("persistent", std::to_string(_app->num_tracked(0, (size_t)std::max(1.0, param("seed_track_frames", 3.0)))));
+  value("msckf", std::to_string(init ? (int)_app->get_good_features_MSCKF().size() : 0));
+  value("slam", std::to_string(init ? _app->num_slam() : 0));
+  value("zupt", (init && _app->last_was_zupt()) ? "1" : "0");
+  value("gyro", format("%.4f", gyro));
+  if (init) {
+    value("speed", format("%.4f", state->_imu->vel().norm()));
+    // the IMU's velocity in its own axes (R_GtoI v_IinG), held against the EKF's by the keeper
+    Eigen::Vector3d v_I = state->_imu->Rot() * state->_imu->vel();
+    value("v_I", format("%.4f,%.4f,%.4f", v_I(0), v_I(1), v_I(2)));
+    std::vector<std::shared_ptr<ov_type::Type>> vars = {state->_imu->pose()->p()};
+    Eigen::MatrixXd P = StateHelper::get_marginal_covariance(state, vars);
+    value("pos_sigma", format("%.4f", std::sqrt(std::max(P.trace(), 0.0))));
+    value("bg", format("%.5f", state->_imu->bias_g().norm()));
+    value("ba", format("%.4f", state->_imu->bias_a().norm()));
+  }
+  value("bias_age", format("%.1f", bias_age));
+  value("resets", std::to_string(epoch.load()));
+  value("warm_seeds", std::to_string(warm_seeds.load()));
+  value("standard_inits", std::to_string(standard_inits.load()));
+  value("seed", seed);
+  pub_health->publish(msg);
+}
+
+double ROS2Visualizer::param(const std::string &name, double fallback) {
+  rclcpp::Parameter parameter;
+  if (!_node->get_parameter(name, parameter)) {
+    return fallback;
+  }
+  switch (parameter.get_type()) {
+  case rclcpp::ParameterType::PARAMETER_DOUBLE:
+    return parameter.as_double();
+  case rclcpp::ParameterType::PARAMETER_INTEGER:
+    return (double)parameter.as_int();
+  case rclcpp::ParameterType::PARAMETER_BOOL:
+    return parameter.as_bool() ? 1.0 : 0.0;
+  default:
+    return fallback;
+  }
+}
+
+std::string ROS2Visualizer::global_frame() const {
+  int n = epoch.load();
+  return (n == 0) ? std::string("global") : "global_" + std::to_string(n);
 }
