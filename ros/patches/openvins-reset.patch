+                   "%.4f, %.4f\n" RESET,
+             timestamp, state->_imu->quat()(0), state->_imu->quat()(1), state->_imu->quat()(2), state->_imu->quat()(3), state->_imu->vel()(0),
+             state->_imu->vel()(1), state->_imu->vel()(2), state->_imu->bias_g()(0), state->_imu->bias_g()(1), state->_imu->bias_g()(2),
+             state->_imu->bias_a()(0), state->_imu->bias_a()(1), state->_imu->bias_a()(2));
+}
+
+int VioManager::num_tracked(size_t cam_id, size_t min_frames) {
+  auto last_ids = trackFEATS->get_last_ids();
+  auto it = last_ids.find(cam_id);
+  if (it == last_ids.end()) {
+    return 0;
+  }
+  if (min_frames <= 1) {
+    return (int)it->second.size();
+  }
+  int count = 0;
+  auto db = trackFEATS->get_feature_database();
+  for (size_t id : it->second) {
+    std::shared_ptr<Feature> feat = db->get_feature(id);
+    if (feat == nullptr) {
+      continue;
+    }
+    auto times = feat->timestamps.find(cam_id);
+    if (times != feat->timestamps.end() && times->second.size() >= min_frames) {
+      count++;
+    }
+  }
+  return count;
+}
