# The laptop half of the stack: the board's sensor image plus what only a laptop should carry —
# Nav2, RTAB-Map (camera + lidar SLAM with appearance-based loop closure), the image pipeline, and
# the monocular depth network that turns the camera into a depth sensor (CPU: 0.33 s a frame
# on the Docker VM, enough for 1 Hz map nodes). Built by ros/laptop-build.sh on top of
# ros/build-image.sh's pepin-ros:sensors; the board never sees this image.
# BASE is what the last stage (the stall look's BT node) is built on: the stage below by default,
# or an existing laptop image (ros/laptop-build.sh gaze), which then changes by that node alone.
ARG BASE=laptop
FROM pepin-ros:sensors AS laptop
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        ros-jazzy-navigation2 ros-jazzy-nav2-bringup \
        ros-jazzy-rtabmap-ros ros-jazzy-rtabmap-slam ros-jazzy-rtabmap-viz \
        ros-jazzy-cv-bridge ros-jazzy-image-transport ros-jazzy-image-transport-plugins \
        ros-jazzy-camera-calibration-parsers ros-jazzy-foxglove-bridge python3-opencv python3-pip \
    && rm -rf /var/lib/apt/lists/*
# Depth Anything V2, metric indoor, small: the weights are fetched at build time so a launch
# never depends on the internet (HF_HUB_OFFLINE keeps the library from trying).
ARG DEPTH_MODEL=depth-anything/Depth-Anything-V2-Metric-Indoor-Small-hf
ENV PEPIN_DEPTH_MODEL=$DEPTH_MODEL HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN python3 -m pip install -q --break-system-packages --no-cache-dir torch torchvision \
        --index-url https://download.pytorch.org/whl/cpu \
    && python3 -m pip install -q --break-system-packages --no-cache-dir transformers pillow \
    && HF_HUB_OFFLINE=0 TRANSFORMERS_OFFLINE=0 python3 -c "from transformers import AutoImageProcessor, AutoModelForDepthEstimation; \
        AutoImageProcessor.from_pretrained('$DEPTH_MODEL'); AutoModelForDepthEstimation.from_pretrained('$DEPTH_MODEL')"

# The stall look's behaviour tree node (ros/pepin_gaze_bt: AskGaze, which bt_navigator loads as
# pepin_ask_gaze_bt_node; nav.launch.py cuts the look out of the tree on an image without it).
FROM ${BASE}
# The MCAP library the bag recorder's ring cuts a goal's bag with (pepin.bag_slice, flag goal_bag
# ring; the node refuses the ring without it). The version uv.lock pins.
RUN python3 -m pip install -q --break-system-packages --no-cache-dir "mcap==1.5.0"
COPY pepin_gaze_bt /ws/src/pepin_gaze_bt
RUN . /opt/ros/jazzy/setup.sh && cd /ws \
    && colcon build --packages-select pepin_gaze_bt --cmake-args -DCMAKE_BUILD_TYPE=Release \
    && rm -rf build log
# rmw_zenoh_cpp's lost wake-up, fixed (ros/patches/rmw_zenoh-lost-wakeup.patch): the .so that
# ros/tools/build_rmw_zenoh_fix.sh built goes over the apt one while that is 0.2.10 (the build
# refuses a 0.2.10 image without it; from 0.2.11 on the fix is upstream and nothing is copied).
COPY build/rmw_zenoh_fix/ tools/install_rmw_zenoh_fix.sh /tmp/rmw_zenoh_fix/
RUN sh /tmp/rmw_zenoh_fix/install_rmw_zenoh_fix.sh /tmp/rmw_zenoh_fix && rm -rf /tmp/rmw_zenoh_fix
