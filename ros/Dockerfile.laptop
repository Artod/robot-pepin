# The laptop half of the stack: the board's image plus what only a laptop should carry —
# RTAB-Map (camera + lidar SLAM with appearance-based loop closure) and the image pipeline.
# Built by ros/laptop-build.sh; the board never sees this image.
FROM pepin-ros:latest
RUN apt-get update -qq && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
        ros-jazzy-rtabmap-ros ros-jazzy-rtabmap-slam ros-jazzy-rtabmap-viz \
        ros-jazzy-cv-bridge ros-jazzy-image-transport ros-jazzy-image-transport-plugins \
        ros-jazzy-camera-calibration-parsers python3-opencv \
    && rm -rf /var/lib/apt/lists/*
