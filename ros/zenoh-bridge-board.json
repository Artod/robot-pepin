{
  "plugins": {
    "ros2dds": {
      "allow": {
        "publishers": [
          "^/(imu/data_raw|local_costmap/costmap|localization/sigma|localization/sources|localization_fit|map_tracked|neck/state|odom|odometry/filtered|pepin/run_status|places/mark|scan|tf|tf_static|tof/front|tof/left|tof/right|tracker_pose)$"
        ],
        "subscribers": [
          "^/(bridge/kick|contact_scan|controller_selector|depth_marks|depth_scan|laptop/heartbeat|map|pepin/run|places|places/marked|plan|planner_selector|rtabmap/info|rtabmap/mapGraph|rtabmap/mapPath|vo)$"
        ],
        "service_servers": [
          "^/(behavior_server/change_state|behavior_server/get_state|bt_navigator/change_state|bt_navigator/get_state|controller_server/change_state|controller_server/get_state|relocalize|velocity_smoother/change_state|velocity_smoother/get_state|where_am_i)$"
        ],
        "service_clients": [
          "^/(global_costmap/clear_entirely_global_costmap)$"
        ],
        "action_servers": [
          "^/(navigate_through_poses|navigate_to_pose)$"
        ],
        "action_clients": [
          "^/(compute_path_through_poses|compute_path_to_pose)$"
        ]
      },
      "pub_max_frequencies": [
        "^/imu/data_raw$=20",
        "^/odom$=20",
        "^/odometry/filtered$=20",
        "^/tf$=20"
      ],
      "queries_timeout": {
        "default": 5.0
      },
      "reliable_routes_blocking": false
    }
  }
}
