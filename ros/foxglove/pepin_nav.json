        "behavior_server",
        "controller_server",
        "planner_server",
        "relocalizer",
        "amcl"
      ],
      "minLogLevel": 2,
      "nameFilter": {}
    },
    "Plot!fit": {
      "paths": [
        {
          "value": "/localization_fit.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "scan-to-map fit"
